<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cc.face.mapper.FaceImageMapper">
    <resultMap id="FaceImageMap" type="cn.cc.face.dao.FaceImage">
        <id property="id" column="id"/>
        <result property="personName" column="person_name"/>
        <result property="imagePath" column="image_path"/>
        <result property="feature" column="feature"/>
        <result property="featureJson" column="feature_json"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>
    <select id="selectAllOrderByCreatedAtDesc" resultMap="FaceImageMap">
        SELECT * FROM ai_test.face_image ORDER BY created_at DESC
    </select>
    <select id="selectById" resultMap="FaceImageMap">
        SELECT * FROM ai_test.face_image WHERE id = #{id}
    </select>
    <insert id="insert" parameterType="cn.cc.face.dao.FaceImage">
        INSERT INTO ai_test.face_image (person_name, image_path, feature, feature_json)
        VALUES (#{personName}, #{imagePath}, #{feature}, #{featureJson})
    </insert>
    <update id="updatePersonName">
        UPDATE ai_test.face_image SET person_name = #{personName} WHERE id = #{id}
    </update>
    <delete id="deleteById">
        DELETE FROM ai_test.face_image WHERE id = #{id}
    </delete>
</mapper> 